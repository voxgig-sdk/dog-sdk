# Entity: breed

main: kit: entity: breed: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "message"
      req: false
      short: "Array of sub-breed names"
      type: "`$ARRAY`"
    }
    {
      name: "status"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "breed"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                example: "hound"
                kind: "param"
                name: "id"
                orig: "breed"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/breed/{breed}/list"
          rename: {
            param: {
              breed: "id"
            }
          }
          segments: [
            {
              lit: "breed"
            }
            {
              var: "id"
            }
            {
              lit: "list"
            }
          ]
          select: {
            "$action": "list"
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.message`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/breeds/list/all"
          segments: [
            {
              lit: "breeds"
            }
            {
              lit: "list"
            }
            {
              lit: "all"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.message`"
          }
        }
      ]
    }
  }



}
